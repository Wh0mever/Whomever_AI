# Пример конфигурации для WHOMEVER AI Bot
# Скопируйте этот файл как .env и заполните реальными значениями

# ОБЯЗАТЕЛЬНЫЕ переменные
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUVwxyz
OPENAI_API_KEY=sk-proj-abcdefghijklmnop1234567890
BOT_ADMIN_ID=123456789

# Где получить токены:
# TELEGRAM_BOT_TOKEN - @BotFather в Telegram
# OPENAI_API_KEY - https://platform.openai.com/api-keys  
# BOT_ADMIN_ID - ваш Telegram ID (узнать у @userinfobot) 