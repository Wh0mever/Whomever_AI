# Игнорировать все .env файлы, кроме корневого
!.env
.env*
*.env

# Игнорировать кэш Python
__pycache__/
*.py[cod]
*$py.class

# Игнорировать виртуальное окружение
venv/
env/
ENV/

# Игнорировать локальные файлы
uploads/
temp/
*.log

# Игнорировать базу данных
*.db
*.sqlite3

# Игнорировать системные файлы
.DS_Store
Thumbs.db 